meta {
  name: [POST] api/auth/login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
      "username": "abedaa123",
     
      "password": "1234aaaaaa"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
